{
  "manifest_version": 3,
  "name": "CinePulse YouTube Controller",
  "version": "1.1.0",
  "description": "Receives CinePulse playback commands through the local CinePulse Controller and controls YouTube.",
  "permissions": [],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
