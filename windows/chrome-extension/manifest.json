{
  "manifest_version": 3,
  "name": "CinePulse YouTube Controller",
  "version": "1.0.0",
  "description": "Receives CinePulse commands over the local Wi-Fi network and controls YouTube.",
  "permissions": ["scripting"],
  "host_permissions": ["https://www.youtube.com/*", "http://127.0.0.1:8765/*", "http://localhost:8765/*"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
